pipeline {
    agent any
    environment {
        HOME = "${WORKSPACE}"
    }
    stages {
        stage('Preparar entorno') {
            agent {
                docker {
                    image 'python:3.12-slim'
                    reuseNode true
                }
            }
            steps {
                sh 'python -m venv .venv'
                sh '.venv/bin/pip install -r requirements-dev.txt'
            }
        }
        stage('Detección de secretos') {
            agent {
                docker {
                    image 'ghcr.io/gitleaks/gitleaks:v8.30.1'
                    args '--entrypoint='
                    reuseNode true
                }
            }
            steps {
                sh 'gitleaks git --redact --no-banner --no-color -v --report-path reports/gitleaks.json .'
            }
        }
        stage('SCA') {
            agent {
                docker {
                    image 'python:3.12-slim'
                    reuseNode true
                }
            }
            steps {
                sh '.venv/bin/pip install pip-audit'
                sh '.venv/bin/pip-audit -r requirements-dev.txt'
            }
        }
        stage('Pruebas') {
            agent {
                docker {
                    image 'python:3.12-slim'
                    reuseNode true
                }
            }
            steps {
                echo 'Ejecutando pruebas'
                sh '.venv/bin/python -m pytest --junitxml=reports/junit.xml'
            }
        }
    }
}